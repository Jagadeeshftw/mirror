# Mirror engine. Copy to .env (never commit real keys). Everything except keys has a default.

# --- chain ---
NETWORK=mainnet                      # mainnet | localFork (selects shared/config.json network)
RPC_URL=https://rpc.monad.xyz        # default from shared/config.json
WS_RPC_URL=wss://rpc.monad.xyz       # monadLogs/monadNewHeads; unset on localFork -> ws://127.0.0.1:8545 or polling
LOG_SUBSCRIPTION=auto                # auto | monad | standard | poll
# SHARED_CONFIG_PATH=../shared/config.json

# --- Mirror contracts (null in shared/config.json until mainnet deploy) ---
FACTORY_ADDRESS=
KEEPER_REGISTRY_ADDRESS=
MIRROR_DEPLOY_BLOCK=

# --- signers (one key may serve every role) ---
KEEPER_PRIVATE_KEYS=                 # comma-separated; each must be registered in KeeperRegistry
RELAYER_PRIVATE_KEY=                 # defaults to the first keeper key
DEMO_LEADER_PRIVATE_KEY=             # team-run EOA with its own Perpl account; enables /v1/demo/*
DEMO_FOLLOWER_ACCOUNT=               # team-run MirrorAccount following the demo leader
TEAM_RUN_ADDRESSES=                  # extra team-run EOAs/accounts, excluded from /v1/stats counts

# --- Perpl public API (geo-blocks US/GB: run in an EU region) ---
PERPL_API_URL=https://app.perpl.xyz/api
PERPL_WS_URL=wss://app.perpl.xyz
PERPL_WS_ENABLED=1

# --- copy engine ---
SLIPPAGE_SAFETY_BPS=5
MAX_MATCHES=100
PRIORITY_FEE_GWEI=2
GAS_LIMIT_MULTIPLIER=1.2               # x Monad eth_estimateGas; never a fixed limit (Monad charges the full limit)
BOOK_GAS_LIMIT_MULTIPLIER=1.3          # keeper copies, stop triggers, trading actions (book can move)
TX_TIMEOUT_MS=20000
# BLOCKED_SUBMIT_REASONS=LeverageTooHigh,LeverageTooLow,SlippageTooHigh,ExceedsMaxNotional,ExceedsLeaderTarget,DailyLossStop,DrawdownStop,StaleMark,EntryTooFar,MarketHeldByOtherLeader,LeaderBudgetExceeded,LeaderLossStop,BuilderFeeTooHigh
STOP_EXECUTOR_ENABLED=1              # triggerLevel / triggerAccountStop / triggerLeaderStop, simulated first
STOP_EXECUTOR_PRIVATE_KEY=           # optional; defaults to the keeper pool
STOP_CHECK_MS=3000
STOP_RETRY_MS=15000
CIRCUIT_FAILURES=5
CIRCUIT_COOLDOWN_MS=30000

# --- demo (judge path) ---
DEMO_PERP_ID=1
DEMO_LOTS=1
DEMO_LEVERAGE_HDTHS=200
DEMO_BLOCKED_LEVERAGE_HDTHS=1000
DEMO_HOLD_MS=20000
DEMO_IP_HOURLY=3
DEMO_DAILY_CAP=48

# --- limits ---
RELAY_OWNER_HOURLY=30
RELAY_IP_HOURLY=60
QUOTE_IP_MINUTE=30

# --- leaders ---
INDEXER_GRAPHQL_URL=                 # Envio/Hasura <host>/v1/graphql; unset -> engine computes the ranking
LEADER_BACKFILL_BLOCKS=20000

# --- follower protection (docs/engine.md) ---
THIN_BOOK_GUARD_ENABLED=1            # 0 on anvil (no Perpl book reachable)
THIN_BOOK_DEPTH_MULTIPLE=2           # book depth within the limit must be >= this x the copy's lots
ADVERSARIAL_EXIT_BLOCKS=20
ADVERSARIAL_MOVE_BPS=30
ADVERSARIAL_WORSE_BPS=20
ADVERSARIAL_FLAG_SCORE=25
ADVERSARIAL_MIN_INCIDENTS=2
ADVERSARIAL_REFUSE_FOLLOWS=0         # 1: refuse new follows of flagged leaders (default: only flag)

# --- backtest (POST /v1/leaders/:id/backtest; needs INDEXER_GRAPHQL_URL) ---
BACKTEST_DEFAULT_SLIPPAGE_BPS=5      # used when fewer than 3 copies of the leader were measured
BACKTEST_TAKER_FEE_BPS=3.5
BACKTEST_MAX_EVENTS=20000

# --- Nansen (auto: API key if set, else x402 if a payer is set, else no Nansen signal) ---
NANSEN_ENABLED=auto                  # auto | 0 (force off) | 1
NANSEN_API_KEY=                      # used first; labels need it (excluded from x402)
NANSEN_PAYER_PRIVATE_KEY=            # x402 pay-per-call (USDC on Monad, eip155:143); fallback when the key is refused
NANSEN_MAX_PER_CALL=50000            # $0.05 cap per call (USDC base units)
NANSEN_DAILY_BUDGET=1000000          # $1/day

# --- alerts (encrypted to each device's passkey-derived key; see docs/api.md, Push) ---
# Android push through FCM HTTP v1 (Firebase service account: a secret, never commit it or copy it into the repo).
# Locally point at the gitignored key file; on hosting put the JSON in FCM_SERVICE_ACCOUNT_JSON instead.
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
# Test hook (refused unless NETWORK=localnet): FCM_ENDPOINT_OVERRIDE=
# Expo push: optional fallback for Expo tokens registered earlier.
PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=
# Web Push (VAPID, no Firebase). Generate with `pnpm gen:vapid`; keep the private key secret, never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://mirror.0xo.in
PUSH_RATE_PER_MIN=20
PUSH_MAX_AGE_SEC=900
PUSH_LOW_EQUITY_PCT=50
# Stage-A only (refused unless NETWORK=localnet): PUSH_WEBPUSH_ENDPOINT_OVERRIDE=http://127.0.0.1:8817/push

# --- server ---
PORT=8080
DB_PATH=./data/engine.db
LOG_LEVEL=info
CORS_ORIGINS=*
