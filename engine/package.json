{
  "name": "@mirror/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Mirror copy engine and relayer for Perpl on Monad",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:abi": "tsx scripts/gen-abi.ts",
    "e2e:fork": "tsx scripts/e2e-fork.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "viem": "^2.57.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
