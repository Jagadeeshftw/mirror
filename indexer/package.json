{
  "name": "mirror-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Envio HyperIndex indexer for Mirror (copy trading on Perpl, Monad mainnet)",
  "type": "module",
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "dev:rpc": "ENVIO_RPC_MODE=sync envio dev",
    "start": "envio start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout=30000",
    "sample": "node scripts/export-samples.mjs"
  },
  "dependencies": {
    "envio": "3.12.1",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
