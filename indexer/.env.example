# HyperSync token (production). Create at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Data source mode for the RPC entry: "fallback" (default, HyperSync primary) or "sync" (RPC only, no token)
ENVIO_RPC_MODE=fallback
ENVIO_RPC_URL=https://rpc.monad.xyz

# First block to index. Perpl Exchange was deployed at 54773010.
ENVIO_START_BLOCK=54773010

# Mirror contracts (fill in after deploy; the zero address disables Mirror indexing)
ENVIO_MIRROR_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ENVIO_MIRROR_START_BLOCK=54773010

# Team-run accounts: comma-separated addresses (EOAs, MirrorAccounts, owners) and/or Perpl account ids.
# Added to the build-time lists TEAM_RUN_ADDRESSES / TEAM_RUN_ACCOUNT_IDS in src/lib/constants.ts.
ENVIO_TEAM_RUN_ADDRESSES=
ENVIO_TEAM_RUN_ACCOUNT_IDS=

# Resolve the address of Perpl accounts first seen without an AccountCreated event (partial syncs) via eth_call.
ENVIO_RESOLVE_PERPL_ADDRESSES=true
