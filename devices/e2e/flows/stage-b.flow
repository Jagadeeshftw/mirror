# Stage-B end-to-end of the Android app on PUBLIC Monad testnet (chain 10143), on emulators mirror-a / mirror-b.
# The engine runs on the host (scripts/engine-testnet-local.sh, port 8838) while the hosted one waits on its secrets;
# contracts, Perpl's testnet exchange, the demo leader (Perpl account 1000) and every account are the live testnet ones.
# APK: app/scripts/build-apk.sh --stage-b (release signing, real Mera passkeys, rpId mirror.0xo.in, API 10.0.2.2:8838).
# Run with devices/run-stage-b-android.sh. ${HOOK} = localnet/stage-b-hook.mjs (reads, plus the demo leader's own orders).
# Accounts: mirror-a restores the demo follower's owner 0x3aBF…6C78 (passkey "Mirror probe 2026-10-06…"), mirror-b the
# test user 0x1bbD…040D (passkey "Probe 2026-10-06…"). Each wallet holds 150 test AUSD from Perpl.

# ---------- 1. demo follower owner on mirror-a ----------
step 01 restore the demo follower's owner with its passkey (mirror-a)
device a
launch
waitFor id:onboarding.screen 60
tap id:onboarding.restore
passkey 90 "^Mirror probe 2026-10-06"
waitFor id:restore.go.home 120
tap id:restore.go.home
open /funds
readText id:funds.address addr "^0x[0-9a-fA-F ]{40,60}$" 30
squash addr
assertVar addr "^0x3[aA][bB][fF]625[bB][eE]454"

step 02 wallet shows the 150 test AUSD from Perpl
open /home
expectResult id:home.balance.ausd "^150\.00$" 60

step 03 follow the demo leader (Perpl 1000): 150 test AUSD, fee line, one passkey prompt
open /leader/1000
waitFor id:leader.screen 30
tap id:leader.follow
waitFor id:follow.sheet 20
setText id:follow.amount.input 150
tap id:follow.seeWhatIf
tap id:follow.review
expectResult id:follow.review.fee "Mirror fee: 0\.02% of opening size \(builder 26\)" 20
tap id:follow.confirm
passkey 90
expectResult id:follow.status "^(Following|Matched)$" 180
shell ${HOOK} follow-check ${addr}
tap id:follow.done

# ---------- 2. a real leader trade on Perpl testnet, copied ----------
step 04 demo leader opens 50 lots BTC on Perpl testnet -> copy with builder 26 fee onchain
shell ${HOOK} leader-trade open 50
shell ${HOOK} wait-copy ${addr} open
tap id:home.tab.activity
expectResult "idtext:activity\.item\.\d+~COPY.*${copy_open_tx}" "fee 0\.0*[1-9]" 90
tap "idtext:activity\.item\.\d+~COPY.*${copy_open_tx}"
waitFor id:copy.detail 15
expectResult id:copy.proof.leaderFill "^[0-9][0-9,]*\.[0-9]$" 10
expectResult id:copy.proof.yourFill "^[0-9][0-9,]*\.[0-9]$" 10
expectResult id:copy.proof.deviation "bps" 10
expectResult id:copy.proof.yourTx "${copy_open_tx}" 10
scrollTo id:copy.proof.fee
readText id:copy.proof.fee feeOpen "builder 26\) \| (0\.0*[1-9][0-9]* (test )?AUSD)" 10
tap id:copy.detail.close

# ---------- 3. test user on mirror-b ----------
step 05 restore the test user with its passkey (mirror-b)
device b
install
launch
waitFor id:onboarding.screen 60
tap id:onboarding.restore
passkey 90 "^Probe 2026-10-06"
waitFor id:restore.go.home 120
tap id:restore.go.home
open /funds
readText id:funds.address addrB "^0x[0-9a-fA-F ]{40,60}$" 30
squash addrB
assertVar addrB "^0x1[bB][bB][dD]7[eE]3333"

step 06 test user follows the demo leader with 100 test AUSD (match now)
open /leader/1000
waitFor id:leader.screen 30
tap id:leader.follow
waitFor id:follow.sheet 20
setText id:follow.amount.input 100
tap id:follow.seeWhatIf
tap id:follow.review
expectResult id:follow.review.fee "builder 26" 20
tap id:follow.confirm
passkey 90
expectResult id:follow.status "^(Following|Matched)$" 180
shell ${HOOK} follow-check ${addrB}
tap id:follow.done
shell ${HOOK} lots ${addrB} lotsB

step 07 stop following, keep my positions (one passkey prompt): set onchain by the test user's contract
open /leader/1000
waitFor id:leader.screen 30
tap id:leader.stopFollow
waitFor id:stop.sheet 15
tap id:stop.option.keep
tap id:stop.confirm
passkey 90
shell ${HOOK} detached ${addrB} 1
expectResult id:follow.status "Stopped, positions kept" 60

# ---------- 4. the leader exits: copied to the demo follower, refused for the detached test user ----------
step 08 demo leader closes -> demo follower's close copied (no builder fee), test user keeps the position
shell ${HOOK} leader-trade close 50
shell ${HOOK} wait-copy ${addr} close
shell ${HOOK} lots ${addrB} lotsKept
assertVar lotsKept "^${lotsB}$"

step 09 test user closes the kept position themselves (Close all, one passkey prompt)
tap id:home.tab.portfolio
tap id:portfolio.closeAll
waitFor id:closeAll.dialog 10
tap id:portfolio.closeAll.confirm
passkey 90
expectResult id:portfolio.positions.count "^0$" 120
shell ${HOOK} lots ${addrB} lotsAfter
assertVar lotsAfter "^0$"

step 10 test user withdraws back to the wallet (one passkey prompt)
open /withdraw
tap id:withdraw.max 20
tap id:withdraw.continue
waitFor id:withdraw.sheet 10
tap id:withdraw.confirm
passkey 90
expectResult id:withdraw.status "^Confirmed$" 180
shell ${HOOK} wallet ${addrB}

# ---------- 5. a copy the demo follower's rule blocks ----------
step 11 demo leader opens at 10x -> the demo follower's leverage rule blocks it onchain
device a
shell ${HOOK} leader-trade open 20 1000
tap id:home.tab.activity
expectResult "idtext:activity\.item\.\d+~.*" "Not copied" 120
shell ${HOOK} leader-trade close 20
