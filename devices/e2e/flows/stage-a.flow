# Stage-A end-to-end of the native app (Group 1) on mirror-a / mirror-b against Perpl's exchange on the localnet.
# Run with devices/run-stage-a-android.sh (starts the localnet + engine, sets ${HOOK}, stops everything).
# Needs the stage-a APK (app/scripts/build-apk.sh --stage-a: release build, real Mera passkeys, rpId
# mirror.0xo.in, API http://10.0.2.2:8828) and both emulators signed in to the same Google account.
# Chain actions (faucet, leader trades with anvil test keys, mark moves) go through ${HOOK} = localnet/stage-a-hook.mjs.

# ---------- 1. create account on mirror-a: one passkey prompt ----------
step 01 create account (one passkey prompt)
device a
launch
waitFor id:onboarding.screen 60
shell ${HOOK} devtime emulator-5554 t1
tap id:onboarding.createAccount
passkey 90
shell ${HOOK} devtime emulator-5554 t2
waitFor id:home.screen 90

step 02 watch mode Home with the Team-run label
waitFor id:home.watch 30
expectResult id:watch.teamRun "Team-run" 30
expectResult id:home.equity "^0\.00$" 10
expectResult id:watch.source "Live" 30

step 03 wallet address (Add funds)
open /funds
readText id:funds.address addr "^0x[0-9a-fA-F ]{40,60}$" 30
squash addr
assertVar addr "^0x[0-9a-fA-F]{40}$"
open /home
waitFor id:watch.runDemo 30

# ---------- 2. Run demo trade: copy detail with proof and the builder fee ----------
step 04 Run demo trade -> copy lands in watch mode
scrollTo id:watch.runDemo
tap id:watch.runDemo
shell ${HOOK} demo-copy open
scrollTo "idtext:watch\.feed\.\d+~Open .*${demo_open_tx}"
expectResult "idtext:watch\.feed\.\d+~Open .*${demo_open_tx}" "fee 0\.0*[1-9]" 30

step 05 demo copy detail: proof (fills, deviation, latency, txs) and builder fee > 0 on the open
tap "idtext:watch\.feed\.\d+~Open .*${demo_open_tx}"
waitFor id:copy.detail 15
expectResult id:copy.proof.leaderFill "^[0-9][0-9,]*\.[0-9]$" 10
expectResult id:copy.proof.yourFill "^[0-9][0-9,]*\.[0-9]$" 10
expectResult id:copy.proof.deviation "bps" 10
expectResult id:copy.proof.latencyMs "[0-9] s" 10
expectResult id:copy.proof.yourTx "${demo_open_tx}" 10
expectResult id:copy.proof.leaderTx "^0x" 10
scrollTo id:copy.proof.fee
readText id:copy.proof.fee feeOpen "builder 26\) \| (0\.0*[1-9][0-9]* AUSD)" 10
tap id:copy.detail.close

step 06 demo close copy detail: builder fee row 0 on the close
shell ${HOOK} demo-copy close
scrollTo "idtext:watch\.feed\.\d+~Close.*${demo_close_tx}"
tap "idtext:watch\.feed\.\d+~Close.*${demo_close_tx}"
waitFor id:copy.detail 15
scrollTo id:copy.proof.fee
readText id:copy.proof.fee feeClose "builder 26\) \| (0(\.0+)? AUSD)" 10
tap id:copy.detail.close

# ---------- 3. Run blocked trade ----------
step 07 Run blocked trade -> Blocked card and detail
scrollTo id:watch.runBlocked up
expectResult id:watch.runDemo "^Run demo trade$" 90
tap id:watch.runBlocked
scrollTo "idtext:watch\.feed\.\d+~Not copied. Your rule: Max leverage 5x"
tap "idtext:watch\.feed\.\d+~Not copied. Your rule: Max leverage 5x"
waitFor id:blocked.detail 15
expectResult id:blocked.title "max leverage" 10
expectResult id:blocked.sentence "10x.*5x" 10
tap id:blocked.done

# ---------- 4. fund the wallet through the localnet faucet ----------
step 08 fund via the faucet (100 AUSD); balance chip updates
shell ${HOOK} fund ${addr} 100
expectResult id:home.balance.ausd "^100\.00$" 60

# ---------- 5. Leaders -> demo leader -> follow ----------
step 09 Leaders tab, then the team-run demo leader's profile
tap id:home.tab.leaders
waitFor id:leaders.list 30
open /leader/3
waitFor id:leader.screen 30
expectResult id:leader.follow "Follow 0x9965" 20

step 10 follow sheet: 20 AUSD, sizing 10%, entry filter 1%
tap id:leader.follow
waitFor id:follow.sheet 20
tap id:follow.amount.20
tapAt id:follow.ratio.slider 0.99 0.5
expectResult id:follow.ratio.value "^10%$" 10
scrollTo id:follow.entryFilter.1
tap id:follow.entryFilter.1
expectResult id:follow.entryFilter.value "^1%$" 10

step 11 What if (simulation)
tap id:follow.seeWhatIf
waitFor id:follow.whatif 20
expectResult id:follow.whatif.sim "Simulation" 45
expectResult id:follow.whatif.pnl "[0-9]" 45
expectResult id:follow.whatif.limits "within 1%" 10

step 12 Review with the Mirror fee line
tap id:follow.review
expectResult id:follow.review.fee "Mirror fee: 0\.02% of opening size \(builder 26\)" 20
expectResult id:follow.review.entryFilter "within 1%" 10

step 13 Approve with one passkey prompt -> Following
tap id:follow.confirm
passkey 90
expectResult id:follow.status "^(Following|Matched)$" 120
shell ${HOOK} follow-check ${addr}
tap id:follow.done

# ---------- 6. a leader trade copied into the user ----------
step 14 leader trade (anvil key) copied into the user: feed row with fee
shell ${HOOK} leader-trade 1 0 20
shell ${HOOK} wait-copy ${addr}
tap id:home.tab.activity
expectResult "idtext:activity\.item\.\d+~COPY.*${copyTx}" "fee 0\.0*[1-9]" 45
tap "idtext:activity\.item\.\d+~COPY.*${copyTx}"
waitFor id:copy.detail 15
expectResult id:copy.proof.yourTx "${copyTx}" 10
scrollTo id:copy.proof.fee
readText id:copy.proof.fee feeUserCopy "builder 26\) \| (0\.0*[1-9][0-9]* AUSD)" 10
tap id:copy.detail.close

# ---------- 7. entry filter refuses a copy ----------
step 15 entry filter: mark +3%, leader adds -> Blocked (Entry filter 1%)
shell ${HOOK} mark-move 1 3
sleep 2
shell ${HOOK} leader-trade 1 0 10
shell ${HOOK} wait-blocked ${addr} EntryTooFar
shell ${HOOK} mark-restore 1
expectResult "idtext:activity\.item\.\d+~${blockedTx}" "Entry filter 1%" 45
tap "idtext:activity\.item\.\d+~${blockedTx}"
waitFor id:blocked.detail 15
expectResult id:blocked.title "entry filter" 10
expectResult id:blocked.sentence "Price moved [0-9.]+% past the leader's entry; your limit is 1%" 10
tap id:blocked.done

# ---------- 8. Positions -> Close all ----------
step 16 Positions -> Close all (one passkey prompt)
tap id:home.tab.portfolio
expectResult id:portfolio.positions.count "^[1-9]" 30
tap id:portfolio.closeAll
waitFor id:closeAll.dialog 10
tap id:portfolio.closeAll.confirm
passkey 90
shell ${HOOK} closed ${addr}
expectResult id:portfolio.positions.count "^0$" 60

# ---------- 9. Withdraw ----------
step 17 Withdraw (one passkey prompt) back to the wallet
open /withdraw
tap id:withdraw.max 20
readText id:withdraw.amount.input withdrawAmount "^[0-9.]+$" 10
tap id:withdraw.continue
waitFor id:withdraw.sheet 10
tap id:withdraw.confirm
passkey 90
expectResult id:withdraw.status "^Confirmed$" 120
shell ${HOOK} wallet ${addr}
tap id:withdraw.done

# ---------- 10. restore on mirror-b with the same passkey (Google Password Manager sync) ----------
step 18 restore on mirror-b with the synced passkey -> same address
device b
install
launch
waitFor id:onboarding.screen 60
# The passkey is named "Mirror account · <creation minute>" (device local time), so pick this run's one. Google
# Password Manager sync to mirror-b takes minutes: until it is listed, cancel the picker, wait and try again.
retry 15 60 tapIfPresent id:onboarding.restore ;; tapIfPresent id:restore.retry ;; passkey 60 "^Mirror account · (${t1}|${t2})$"
waitFor id:restore.go.home 90
expectResult id:restore.welcome.back "Welcome back" 10
tap id:restore.go.home
open /funds
readText id:funds.address addrB "^0x[0-9a-fA-F ]{40,60}$" 30
squash addrB
assertVar addrB "^${addr}$"
