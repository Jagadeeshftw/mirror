# Stage-B end-to-end on PUBLIC Monad testnet against the HOSTED engine (https://engine-production-0fd2.up.railway.app),
# on Android emulators mirror-a / mirror-b, with the release APK testers get (app/scripts/build-apk.sh, testnet).
# Run with devices/run-stage-b-android.sh --hosted. ${HOOK} = localnet/stage-b-hook.mjs with ENGINE_URL set.
# Accounts: a brand-new passkey account on mirror-a (no funds); the demo follower's owner 0x3aBF…6C78 restored on
# mirror-a; the test user 0x1bbD…040D restored on mirror-b (149.73 test AUSD in its wallet).

# ---------- 1. a fresh account with no funds ----------
step 01 fresh account on mirror-a: create with one passkey prompt
device a
clear
launch
waitFor id:onboarding.screen 60
tap id:onboarding.createAccount
passkey 90
waitFor id:home.screen 90

step 02 watch mode on the hosted engine: Live, Team-run demo account, Run buttons enabled, no service banner
waitFor id:home.watch 60
expectResult id:watch.teamRun "Team-run" 30
expectResult id:watch.source "Live" 60
expectResult id:home.equity "^0\.00$" 30
scrollTo id:watch.runDemo
expectResult id:watch.runDemo "^Run demo trade$" 90

step 03 Run demo trade from the unfunded account: the copy lands with builder 26's fee onchain
shell ${HOOK} demo-mark
tap id:watch.runDemo
shell ${HOOK} demo-copy open
scrollTo "idtext:watch\.feed\.\d+~Open .*${demo_open_tx}"
expectResult "idtext:watch\.feed\.\d+~Open .*${demo_open_tx}" "fee 0\.0*[1-9]" 90
tap "idtext:watch\.feed\.\d+~Open .*${demo_open_tx}"
waitFor id:copy.detail 15
expectResult id:copy.proof.leaderFill "^[0-9][0-9,]*\.[0-9]$" 15
expectResult id:copy.proof.yourFill "^[0-9][0-9,]*\.[0-9]$" 15
expectResult id:copy.proof.deviation "bps" 15
expectResult id:copy.proof.yourTx "${demo_open_tx}" 15
scrollTo id:copy.proof.fee
readText id:copy.proof.fee feeOpen "builder 26\) \| (0\.0*[1-9][0-9]* (test )?AUSD)" 15
tap id:copy.detail.close

step 04 the demo's close copy follows with no builder fee
shell ${HOOK} demo-copy close

step 05 Run blocked trade from the unfunded account: Blocked onchain with the rule and the numbers
scrollTo id:watch.runBlocked up
expectResult id:watch.runDemo "^Run demo trade$" 120
shell ${HOOK} demo-mark
tap id:watch.runBlocked
shell ${HOOK} demo-blocked
scrollTo "idtext:watch\.feed\.\d+~Not copied.*${demo_blocked_tx}"
tap "idtext:watch\.feed\.\d+~Not copied.*${demo_blocked_tx}"
waitFor id:blocked.detail 20
expectResult id:blocked.title "max leverage" 15
tap id:blocked.done

# ---------- 2. restore from a passkey ----------
step 06 restore the demo follower's owner from its passkey (mirror-a): same address, its follow account found
device a
clear
launch
waitFor id:onboarding.screen 60
tap id:onboarding.restore
passkey 90 "^Mirror probe 2026-10-06"
waitFor id:restore.go.home 120
tap id:restore.go.home
open /funds
readText id:funds.address addr "^0x[0-9a-fA-F ]{40,60}$" 30
squash addr
assertVar addr "^0x3[aA][bB][fF]625[bB][eE]454"
shell ${HOOK} follow-check ${addr}

# ---------- 3. the test user: follow with a permit deposit, a real copy, stop following, close, withdraw ----------
step 07 restore the test user (mirror-b)
device b
install
clear
launch
waitFor id:onboarding.screen 60
tap id:onboarding.restore
passkey 90 "^Probe 2026-10-06"
waitFor id:restore.go.home 120
tap id:restore.go.home
open /funds
readText id:funds.address addrB "^0x[0-9a-fA-F ]{40,60}$" 30
squash addrB
assertVar addrB "^0x1[bB][bB][dD]7[eE]3333"

step 08 alerts on: Android's notification permission (asked only now), then one passkey prompt signs the Firebase registration
open /settings
scrollTo id:settings.alerts.toggle
tap id:settings.alerts.toggle
sleep 3
tapIfPresent text:Allow
passkey 90
scrollTo id:settings.alerts.channel
expectResult id:settings.alerts.channel "Registered · Android push" 90

step 09 follow the demo leader again (one passkey prompt): the contract clears the detach
open /leader/1000
waitFor id:leader.screen 30
tap id:leader.followAgain
passkey 90
shell ${HOOK} detached ${addrB} 0
expectResult id:follow.status "^(Following|Paused)$" 120

step 10 deposit 100 test AUSD into the follow account by permit (one passkey prompt, no gas)
shell ${HOOK} follow-check ${addrB}
open /funds
waitFor id:funds.toDeposit 30
tap id:funds.toDeposit
tapIfPresent id:funds.account.${followAccount}
waitFor id:funds.amount.input 20
setText id:funds.amount.input 100
tap id:funds.confirm
passkey 90
expectResult id:funds.status "^Deposited$" 180
tap id:funds.done
shell ${HOOK} follow-check ${addrB}

step 11 the demo leader opens 50 lots BTC on Perpl testnet: the test user's copy lands with builder 26's fee; Firebase delivers the alert
shell ${HOOK} notif-mark emulator-5556
home
sleep 2
shell ${HOOK} leader-trade open 50
shell ${HOOK} wait-copy ${addrB} open
shell ${HOOK} notif emulator-5556 com.zeroxo.mirror 150
shade fcm-notification-shade
launch
shell ${HOOK} lots ${addrB} lotsB
assertVar lotsB "^[1-9][0-9]*$"

step 12 stop following, keep my positions (one passkey prompt): set onchain by the test user's own contract
open /leader/1000
waitFor id:leader.screen 30
tap id:leader.stopFollow
waitFor id:stop.sheet 15
tap id:stop.option.keep
tap id:stop.confirm
passkey 90
shell ${HOOK} detached ${addrB} 1
expectResult id:follow.status "Stopped, positions kept" 120

step 13 the leader exits: the demo follower's close is copied with no fee; the detached test user keeps the position
shell ${HOOK} demo-mark
shell ${HOOK} leader-trade close 50
shell ${HOOK} demo-copy close
shell ${HOOK} lots ${addrB} lotsKept
assertVar lotsKept "^${lotsB}$"

step 14 close all (one passkey prompt)
open /home
tap id:home.tab.portfolio
tap id:portfolio.closeAll
waitFor id:closeAll.dialog 10
tap id:portfolio.closeAll.confirm
passkey 90
expectResult id:portfolio.positions.count "^0$" 180
shell ${HOOK} lots ${addrB} lotsAfter
assertVar lotsAfter "^0$"

step 15 withdraw to the wallet (one passkey prompt)
open /withdraw
tap id:withdraw.max 20
tap id:withdraw.continue
waitFor id:withdraw.sheet 10
tap id:withdraw.confirm
passkey 90
expectResult id:withdraw.status "^Confirmed$" 180
shell ${HOOK} wallet ${addrB}

# ---------- 4. a copy the demo follower's rule blocks ----------
step 16 the demo leader opens at 10x: the demo follower's 2x rule blocks the copy onchain (watch feed, mirror-a)
device a
launch
shell ${HOOK} demo-mark
shell ${HOOK} leader-trade open 20 1000
shell ${HOOK} demo-blocked
open /home
scrollTo "idtext:watch\.feed\.\d+~Not copied.*${demo_blocked_tx}"
expectResult "idtext:watch\.feed\.\d+~Not copied.*${demo_blocked_tx}" "Not copied" 60
shell ${HOOK} leader-trade close 20
